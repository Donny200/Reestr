# Copy to .env (ignored by Git) and fill in the values before running `docker compose up --build`.
# Services started from the IDE also read this file through spring.config.import.

POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# HMAC-SHA256 secret shared by identity-service, reference-service and function-catalog-service.
# At least 32 bytes; generate with: openssl rand -base64 48
JWT_SECRET=

# Local HTTP stack behind the same-origin nginx proxy on http://localhost:3000: false / Lax.
# HTTPS deployments that serve the frontend from another origin: true / None.
APP_COOKIE_SECURE=false
APP_COOKIE_SAME_SITE=Lax

# Needed only until the first SUPER_ADMIN exists and has changed the initial password (16-200 characters).
BOOTSTRAP_SUPER_ADMIN_EMAIL=
BOOTSTRAP_SUPER_ADMIN_PASSWORD=

# Optional self-service password reset ("Forgot password?"). Leave disabled unless a verified SMTP
# delivery is configured; SUPER_ADMIN can always issue single-use reset links from the admin console.
PASSWORD_RESET_MAIL_ENABLED=false
PASSWORD_RESET_MAIL_FROM=
PUBLIC_BASE_URL=
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=

# Optional e-mail notice "support replied" for visitors who opt in on the Support page (function-catalog-service).
# Off by default: replies are then shown on the Support page and in the unread badge only.
# Reuses SPRING_MAIL_* and PUBLIC_BASE_URL above; set a sender address and HELP_MAIL_ENABLED=true to turn it on.
# APP_COOKIE_SECURE above also sets the Secure flag of the anonymous support cookie (reestr_support).
HELP_MAIL_ENABLED=false
HELP_MAIL_FROM=

# Two-factor authentication (TOTP) for SUPER_ADMIN and ORG_ADMIN accounts in identity-service.
# Disabled in this environment (MFA_ENABLED=false): no second factor is asked for and no key is needed. The code and
# the mfa tables stay in place. To enable it again set MFA_ENABLED=true and provide MFA_ENCRYPTION_KEY: the SAME
# base64 32-byte key that encrypted the existing enrollments (a different key makes them unreadable, and users must
# enroll again); for a fresh installation generate one with: openssl rand -base64 32 (never reuse JWT_SECRET).
# MFA_ENROLLMENT_DEADLINE (ISO-8601 instant, e.g. 2026-12-01T00:00:00Z) lets already existing administrators keep
# signing in with the password alone until that moment while being reminded to enroll; leave empty to require
# enrollment at the next sign-in.
MFA_ENABLED=false
MFA_ENCRYPTION_KEY=
MFA_ENROLLMENT_DEADLINE=

# Azure Translator credentials (function-catalog-service). Leave all three empty to keep automatic translation off:
# content is still saved and queued, and the background worker translates it into every active language once the
# values are supplied (endpoint such as https://api.cognitive.microsofttranslator.com, the resource key and its region).
AZURE_TRANSLATOR_ENDPOINT=
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
# Set to false to pause the background translation worker (queued jobs wait; nothing is lost).
CATALOG_TRANSLATION_ENABLED=true

# Reverse proxies (IP or CIDR, comma-separated) allowed to pass the visitor address (X-Real-IP) to the gateway.
# Compose gives the nginx container the static address 172.28.0.10; everyone else gets the header overwritten.
GATEWAY_TRUSTED_PROXIES=172.28.0.10/32
